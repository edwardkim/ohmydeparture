# Each user must register at data.go.kr and obtain approval and their own key.
# API application: https://www.data.go.kr/data/15140153/openapi.do
# Copy these placeholders into your local .env; never commit a real service key.
ICN_EP=https://apis.data.go.kr/B551177/statusOfAllFltDeOdp
ICN_KEY=YOUR_OWN_DATA_GO_KR_SERVICE_KEY

# Optional maintainer-only refresh of the bundled static airport code reference.
# Users of the bundled snapshot do not need ACODE_EP or ACODE_KEY.
# To refresh it, apply separately for Airport Code Information_GW.
# API application: https://www.data.go.kr/data/15158948/openapi.do
# Requests use /info beneath this base endpoint.
ACODE_EP=https://apis.data.go.kr/B551178/airport-code
ACODE_KEY=YOUR_OWN_DATA_GO_KR_SERVICE_KEY
